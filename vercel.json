{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/auth/callback",
      "destination": "/learning"
    },
    {
      "source": "/learning",
      "destination": "/learning.html"
    },
    {
      "source": "/oauth2callback",
      "destination": "/api/[...slug]?slug=oauth2callback"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...slug]?slug=$1"
    }
  ]
}
