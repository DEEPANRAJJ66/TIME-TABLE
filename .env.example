# ========================================================================
# Learning Resource Platform - Environment Variables Template
# Copy this file to .env and supply your secure server-side credentials.
# NEVER commit .env to source control or expose client-side.
# ========================================================================

# --- Google Drive Storage Integration ---
# Dedicated Approved Folder ID created manually by Google Drive Owner
# Example: 1BxiMVs0XRA5nFMdKvBHK...
GOOGLE_DRIVE_APPROVED_FOLDER_ID=your_approved_google_drive_folder_id_here

# Google OAuth2 Credentials (Authorized for https://www.googleapis.com/auth/drive.file)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token_here

# --- Telegram Bot Audit Trail Configuration ---
# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Dedicated Private Audit Channel ID (e.g., -1003598863042)
TELEGRAM_AUDIT_CHANNEL_ID=-100xxxxxxxxxx

# Dedicated Bug Reporting Channel ID (https://t.me/+DUb_bXrp_x03OGZl -> -1004484073817)
TELEGRAM_BUG_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_BUG_CHANNEL_NAME="Bug report SCE"
TELEGRAM_BUG_CHANNEL_LINK="https://t.me/+xxxxxxxxxxxx"

# Optional Admin Chat ID for direct operational alerts
TELEGRAM_ADMIN_CHAT_ID=your_admin_telegram_chat_id_here

# --- Supabase Database Configuration ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_private_key_here

# --- Server & Port Settings ---
PORT=3000
NODE_ENV=development
